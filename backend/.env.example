# Copy this file to .env and fill in the values. Never share, commit or zip .env.
# Put any value that contains # or spaces in double quotes: DB_PASSWORD="abc#123"

# ---- API server ----
PORT=3000
NODE_ENV=development
# The website is served by this same app, so it needs no CORS permission.
# Only list other addresses that must call the API from a browser (comma-separated,
# no trailing slash), for example http://localhost:5500 for VS Code Live Server.
CORS_ORIGINS=

# ---- Sessions ----
# Secret that signs the opaque session ID cookie (login data stays in MySQL). At least 32 random characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# How long a sign-in lasts, in hours (1-24)
SESSION_HOURS=8

# ---- First admin account (used ONLY by npm run admin:create, then delete the password) ----
ADMIN_NAME="LifeLink Admin"
ADMIN_EMAIL=admin@lifelink.test
ADMIN_PASSWORD=

# ---- Database account used by the API (created by npm run db:setup) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lifelink
DB_USER=lifelink_app
DB_PASSWORD=choose-a-long-random-password

# ---- MySQL administrator, used only by database setup, reset and migration scripts ----
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# Hosts the API account may connect from (comma-separated)
DB_APP_HOSTS=localhost,127.0.0.1

# ---- Optional tuning (defaults shown) ----
# Time zone that decides what "today" is for donation dates
# APP_TIME_ZONE=Asia/Beirut
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10
# DB_POOL_SIZE=10
